    "templating": {
      "list": [
        {
          "name": "client_service",
          "type": "query",
          "label": "Client Service",
          "datasource": {
            "uid": "O46jHU-4z",
            "type": "prometheus"
          },
          "query": {
            "query": "label_values(traces_spanmetrics_calls_total{span_name=~\"HTTP POST.*coverage.*|.*coverage.*\"}, service)",
            "refId": "StandardVariableQuery"
          },
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          "includeAll": true,
          "multi": true,
          "allValue": ".*"
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": {
            "uid": "O46jHU-4z",
            "type": "prometheus"
          },
          "enable": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "tags": ["deploy"],
          "type": "tags"
        }
      ]
    },
